// Prisma schema for Dr. Arun Dental Care — Postgres on Supabase.
// DATABASE_URL is the pooled connection (Supavisor, port 6543, ?pgbouncer=true)
// used by the running API; DIRECT_URL is the direct/session connection
// (port 5432) that Prisma Migrate needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Patient {
  id                 String        @id @default(uuid())
  opNumber            String        @unique
  name                String
  mobile              String
  address             String
  age                 Int?
  gender              String?
  bloodGroup          String?
  occupation          String?
  dentalProblem       String?
  previousTreatment   String?
  photoPath           String
  createdAt           DateTime      @default(now())
  appointments        Appointment[]

  @@index([mobile])
  @@index([name])
}

model Appointment {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  opNumber          String   @unique
  appointmentDate   String
  appointmentTime   String?
  status            String   @default("Pending")
  // Number of treatment sittings/visits this OP has had so far (e.g. root
  // canal spans multiple sittings) — steppable from the admin dashboard.
  sittingCount      Int      @default(1)
  // "Payment Pending" | "Partially Paid" | "Payment Completed" — derived from
  // feeAmount vs. the sum of `payments` (see fees.service.ts); kept as a free
  // string rather than a Prisma enum, matching this schema's existing style.
  paymentStatus     String   @default("Payment Pending")
  // Total fee for this OP in whole rupees. Null until the admin enters it.
  feeAmount         Int?
  payments          Payment[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([appointmentDate])
  @@index([status])
}

// One amount received against an OP's fee — patients often pay in parts
// across sittings. Paid = sum of these; Due = Appointment.feeAmount − Paid.
model Payment {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // Whole rupees.
  amount        Int
  // "Cash" | "UPI" | "Card" | "Bank Transfer" | "Other"
  method        String      @default("Cash")
  note          String?
  paidAt        DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

model OpSequence {
  id         String @id @default(uuid())
  year       Int    @unique
  lastNumber Int    @default(0)
}

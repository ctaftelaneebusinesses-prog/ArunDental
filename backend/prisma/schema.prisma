// Prisma schema for Dr. Arun Dental Care
// Provider is SQLite for local development (zero-install).
// For production, switch datasource.provider to "postgresql" and set
// DATABASE_URL to a Postgres connection string — model definitions below
// are written to be Postgres-compatible without changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Patient {
  id                 String        @id @default(uuid())
  opNumber            String        @unique
  name                String
  mobile              String
  address             String
  age                 Int?
  gender              String?
  bloodGroup          String?
  dentalProblem       String?
  previousTreatment   String?
  photoPath           String
  createdAt           DateTime      @default(now())
  appointments        Appointment[]

  @@index([mobile])
  @@index([name])
}

model Appointment {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  opNumber          String   @unique
  appointmentDate   String
  appointmentTime   String?
  status            String   @default("Pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([appointmentDate])
  @@index([status])
}

model Enquiry {
  id            String   @id @default(uuid())
  name          String
  mobile        String
  message       String
  callbackTime  String?
  status        String   @default("New")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model OpSequence {
  id         String @id @default(uuid())
  year       Int    @unique
  lastNumber Int    @default(0)
}

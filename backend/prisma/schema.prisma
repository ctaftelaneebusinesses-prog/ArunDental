// Prisma schema for Dr. Arun Dental Care — Postgres on Supabase.
// DATABASE_URL is the pooled connection (Supavisor, port 6543, ?pgbouncer=true)
// used by the running API; DIRECT_URL is the direct/session connection
// (port 5432) that Prisma Migrate needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Patient {
  id                 String        @id @default(uuid())
  opNumber            String        @unique
  name                String
  mobile              String
  address             String
  age                 Int?
  gender              String?
  bloodGroup          String?
  occupation          String?
  dentalProblem       String?
  previousTreatment   String?
  photoPath           String
  createdAt           DateTime      @default(now())
  appointments        Appointment[]

  @@index([mobile])
  @@index([name])
}

model Appointment {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id])
  opNumber          String   @unique
  appointmentDate   String
  appointmentTime   String?
  status            String   @default("Pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([appointmentDate])
  @@index([status])
}

model OpSequence {
  id         String @id @default(uuid())
  year       Int    @unique
  lastNumber Int    @default(0)
}

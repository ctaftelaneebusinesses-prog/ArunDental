# Copy this file to .env and fill in real values before running the backend.

# SQLite for local development. For production, point this at a PostgreSQL
# connection string instead (and change schema.prisma's datasource provider
# to "postgresql").
DATABASE_URL="file:./dev.db"

# Used to sign admin session JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Initial admin account, created by `npm run seed`. Change the password
# after first login is implemented, or rotate it by re-running the seed
# with new values.
ADMIN_EMAIL="admin@drarundentalcare.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Clinic Admin"

# Port the API listens on.
PORT=4000

# Origin allowed to call the API with credentials (the frontend dev server
# or, in production, the deployed website origin).
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"

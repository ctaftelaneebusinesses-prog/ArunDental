# Copy this file to .env and fill in real values before running the backend.

# Supabase Postgres (Project Settings > Database > Connection string).
# DATABASE_URL: "Transaction pooler" string (port 6543) - used by the API.
# DIRECT_URL:   "Session pooler" or direct string (port 5432) - used by
#               `prisma migrate deploy`. Replace [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage for patient photos (Project Settings > API).
# The service-role key is a SERVER-ONLY secret - never put it in the frontend
# or commit it. Create a PRIVATE bucket with the name below.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_PHOTO_BUCKET="patient-photos"

# Used to sign admin session JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Initial admin account, created by `npm run seed`. Change the password
# after first login is implemented, or rotate it by re-running the seed
# with new values.
ADMIN_EMAIL="admin@drarundentalcare.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Clinic Admin"

# New-OP email to the doctor (optional — skipped if these values are blank).
# Doctor email via Gmail SMTP: SMTP_PASS must be a Gmail *App Password*
# (Google Account > Security > 2-Step Verification > App passwords), not the
# normal Gmail password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="clinic.sender@gmail.com"
SMTP_PASS="replace-with-16-char-app-password"
MAIL_FROM="clinic.sender@gmail.com"
DOCTOR_EMAIL="doctor@example.com"

# Production on Railway: Railway blocks SMTP on non-Pro plans, so use Brevo's
# HTTPS API instead (brevo.com > SMTP & API > API Keys; free 300 emails/day).
# MAIL_FROM must be a sender verified in Brevo (Senders & IP > Senders).
# When set, this is used instead of the SMTP settings above.
BREVO_API_KEY=""

# Port the API listens on.
PORT=4000

# Origin allowed to call the API with credentials (the frontend dev server
# or, in production, the deployed website origin).
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
